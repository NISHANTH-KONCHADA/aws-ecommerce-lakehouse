# ==============================================================================
# AWS & Storage Configuration Template
# Copy this file to .env and fill in your actual credentials/configurations.
# DO NOT commit your real .env file with secrets to GitHub!
# ==============================================================================

# AWS Authentication (Optional if using AWS CLI named profiles or IAM roles)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_SESSION_TOKEN=

# S3 Data Lake Configuration
# Note: S3 bucket names must be globally unique across all AWS accounts.
S3_BUCKET_NAME=your-unique-ecommerce-lakehouse-bucket

# Execution Mode:
# 'local' -> runs pipeline against local directory structure (zero AWS costs)
# 's3'    -> reads from and writes to AWS S3 buckets
STORAGE_MODE=local

# Local File Paths (used when STORAGE_MODE=local)
LOCAL_DATA_DIR=./data
LOCAL_BRONZE_DIR=./data/bronze
LOCAL_SILVER_DIR=./data/silver
LOCAL_GOLD_DIR=./data/gold
LOCAL_QUARANTINE_DIR=./data/quarantine

# Environment Tagging
ENVIRONMENT=dev
LOG_LEVEL=INFO
